# ── PostgreSQL ──
POSTGRES_DB=garden
POSTGRES_USER=garden
POSTGRES_PASSWORD=changeme_pg_secret

# ── InfluxDB v2 ──
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=changeme_influx_secret
INFLUXDB_INIT_ORG=garden
INFLUXDB_INIT_BUCKET=garden_telemetry
INFLUXDB_INIT_ADMIN_TOKEN=changeme_influx_token

# ── API ──
CORS_ORIGINS=http://localhost:3000
